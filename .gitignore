# ─────────────────────────────────────────────────────────────────────────────
#  QCTF Model — .gitignore
#  Hardened for public open-source deployment
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets — NEVER commit ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Private operational notes (internal use only) ────────────────────────────
PRIVATE_NOTES.md
RESEARCH.md

# ── macOS LaunchAgent plists (contain local absolute paths) ──────────────────
com.metals.*.plist

# ── Legacy / internal sub-apps ───────────────────────────────────────────────
web/
qctf-model/
UI current/
showcase_bundle/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.venv/
venv/

# ── Data artefacts (large / regenerated by pipeline) ─────────────────────────
data/
*.parquet
*.pth
*.pkl
*.joblib

# ── Logs & runtime artefacts ─────────────────────────────────────────────────
logs/
*.log
graphify-out/
backups/

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Next.js ──────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ── AI agent configs (not relevant to the public showcase) ───────────────────
.claude/
AGENTS.md
CLAUDE.md
