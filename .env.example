# ─────────────────────────────────────────────────────────────────────────────
#  Altair MK1 — Environment Variables
#
#  Copy to .env and fill in real values:
#    cp .env.example .env
#
#  NEVER commit .env to version control. The .gitignore should exclude it.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM Agent Keys ─────────────────────────────────────────────────────
# Perplexity Sonar Pro — macro oracle + sentiment analysis
PERPLEXITY_API_KEY=

# DeepSeek — trade analysis and reasoning
DEEPSEEK_API_KEY=

# Google Gemini — analyst agent (gemini-2.5-flash-lite/flash/pro)
GEMINI_API_KEY=

# Anthropic Claude — reserved upgrade path
ANTHROPIC_API_KEY=

# ── Market Data ──────────────────────────────────────────────────────────────
# Federal Reserve Economic Data (FRED) — macro indicators
FRED_API_KEY=

# ── Brokerage ────────────────────────────────────────────────────────────────
# Alpaca — paper/live trading execution
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Notifications ────────────────────────────────────────────────────────────
# Telegram — pipeline alerts and executive briefings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Next.js Dashboard ────────────────────────────────────────────────────────
# RECRUITER SANDBOX      — mock data only; never polls the local API.
# PRODUCTION AUTOMATED   — polls http://localhost:8000/api/snapshot every 5s.
# NOTE: NODE_ENV=production (Vercel) ALWAYS forces RECRUITER SANDBOX regardless of this value.
NEXT_PUBLIC_DASHBOARD_MODE=RECRUITER SANDBOX
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Execution ────────────────────────────────────────────────────────────────
# Order routing target. Permanently pinned to paper_internal (local simulation
# against the internal shadow-vault book).
#   paper_internal  (default, REQUIRED)  — no external broker; nightly pipeline
#                                           runs as a self-contained simulation.
#   paper_ibkr   [DEPRECATED]  — IBKR paper account routing. Disabled by the
#                                IBKR pivot (regional compliance restrictions).
#   live_ibkr    [DEPRECATED]  — IBKR live routing. Disabled by the IBKR pivot.
# Leave as paper_internal. The IBKR modes are retained only for historical
# reference and must not be re-enabled without a compliance review.
EXECUTION_MODE=paper_internal

# ── Treasury Hedge Sleeve (Phase XXV) ────────────────────────────────────────
# Local macro-regime hedge sleeve (TLT/IEF in deflation/crisis regimes). Executes
# ONLY into the internal paper_internal book — never to an external broker.
#   SIGNAL_ONLY  (default)  — recommend only; trader does not execute.
#   LOCAL_ACTIVE            — execute locally into phase14_book.json.
#   ACTIVE       [DEPRECATED — IBKR pivot]
TREASURY_HEDGE_MODE=SIGNAL_ONLY

# STRICT Sharia gate (boolean, default false). Coupon-bearing sovereign debt
# (TLT/IEF) is NEVER allocated unless this is explicitly true. While false, a
# hedge-warranted regime reroutes the sleeve budget to the physical-gold proxy
# GLD (tagged strategy=TREASURY_HEDGE, sub_tag=sharia_fallback_gld).
TREASURY_SHARIA_CLEARED=false

# Hard cap on the sleeve as a percentage of total book equity (defense-in-depth;
# the rule matrix is already capped at 20).
TREASURY_HEDGE_MAX_PCT=20
